{
  "name": "jakeui",
  "version": "0.1.0",
  "private": true,
  "description": "Jake UI — design tokens, icon map, and the Figma↔code contract.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "tokens/globals.css",
    "tokens/index.css",
    "tokens/runtime.css",
    "tokens/fonts.css",
    "icons/phosphor-map.ts",
    "components",
    "lib",
    "figma.map.json",
    "figma.map.schema.json",
    "agent",
    "docs/agent",
    "docs/README.md",
    "docs/tokens",
    "examples/recipes.tsx",
    "AGENTS.md",
    "CLAUDE.md",
    "!components/*.stories.tsx"
  ],
  "exports": {
    "./tokens.css": "./tokens/index.css",
    "./icons": "./icons/phosphor-map.ts",
    "./map": "./figma.map.json",
    "./manifest": "./agent/manifest.json",
    "./fonts.css": "./tokens/fonts.css",
    "./utils": "./lib/public.ts",
    ".": "./components/index.ts"
  },
  "scripts": {
    "tokens:sync": "node scripts/export-tokens.mjs",
    "tokens:check": "node scripts/export-tokens.mjs --check",
    "map:sync": "node scripts/generate-map.mjs",
    "map:check": "node scripts/validate-map.mjs",
    "typecheck": "tsc --noEmit",
    "computed-type:check": "node scripts/computed-type-check.mjs",
    "computed-type:explore": "node scripts/computed-type-check.mjs --explore",
    "check": "npm run tokens:check && npm run map:check && npm run docs:check && npm run agent:check && npm run typecheck && npm run consumer:check && npm run interaction:check",
    "agent": "node scripts/agent.mjs",
    "agent:sync": "node scripts/agent-generate.mjs",
    "agent:check": "node scripts/agent-generate.mjs --check && node scripts/agent-check.mjs && node --test scripts/agent.test.mjs && npm run agent:lint -- --path examples/recipes.tsx",
    "agent:lint": "node scripts/agent-lint.mjs",
    "consumer:check": "node scripts/consumer-check.mjs",
    "interaction:check": "node scripts/interaction-check.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:check": "node scripts/agent-generate.mjs --check && node scripts/agent-check.mjs"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/test-runner": "^0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "playwright-core": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@floating-ui/react": "^0.27.20",
    "tailwind-merge": "^3.0.0"
  }
}
