{
  "name": "jakeui",
  "version": "0.1.0",
  "private": true,
  "description": "Jake UI — design tokens, icon map, and the Figma↔code contract.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "tokens/globals.css",
    "icons/phosphor-map.ts",
    "components",
    "lib",
    "figma.map.json"
  ],
  "exports": {
    "./tokens.css": "./tokens/globals.css",
    "./icons": "./icons/phosphor-map.ts",
    "./map": "./figma.map.json",
    ".": "./components/index.ts"
  },
  "scripts": {
    "tokens:sync": "node scripts/export-tokens.mjs",
    "tokens:check": "node scripts/export-tokens.mjs --check",
    "map:sync": "node scripts/generate-map.mjs",
    "map:check": "node scripts/validate-map.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run tokens:check && npm run map:check && npm run docs:check && npm run typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:adopt": "node scripts/adopt-docs.mjs",
    "docs:check": "node scripts/docs-check.mjs && node scripts/docs-digest.mjs --check",
    "docs:enrich": "node scripts/enrich-docs.mjs",
    "docs:digest": "node scripts/docs-digest.mjs",
    "docs:verify": "node scripts/verify-docs-dump.mjs --compare .figma-docs-hashes.json"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@phosphor-icons/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  }
}
